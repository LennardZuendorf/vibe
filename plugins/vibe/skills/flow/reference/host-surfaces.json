{
  "$comment": "Supported host discovery matrix. Toolkit vibe, lifecycle flow and standalone spec are sibling skill directories. Names are directory-derived. Cursor resources use flow; runtime remains .vibe/run/flow. Foreign and shadowed copies require diagnostics, never cache rewriting.",
  "version": 1,
  "workflow": {
    "skills": [
      "spec",
      "flow",
      "vibe"
    ],
    "skill_entry": "SKILL.md",
    "shared": {
      "skill_root": ".agents/skills/flow",
      "skill_index": ".agents/skills/flow/SKILL.md",
      "machine": ".agents/skills/flow/state-machine.json",
      "cursor": ".vibe/run/flow/state.json",
      "writer": ".agents/skills/flow/scripts/set-state.sh"
    }
  },
  "hosts": [
    {
      "id": "claude",
      "host": "Claude Code",
      "cli": "claude",
      "skills": [
        "plugin/skills/{name}",
        ".claude/skills/{name}"
      ],
      "entry": {
        "kind": "command",
        "path": ".claude/commands/flow.md",
        "invocation": "/flow"
      },
      "package": {
        "manifest": "plugin/.claude-plugin/plugin.json",
        "marketplace": ".claude-plugin/marketplace.json"
      },
      "docs": "https://docs.claude.com/en/docs/claude-code/plugins, https://docs.claude.com/en/docs/claude-code/skills (custom commands merged into skills; .claude/commands/*.md still works)"
    },
    {
      "id": "opencode",
      "host": "OpenCode",
      "cli": "opencode",
      "skills": [
        ".agents/skills/{name}"
      ],
      "entry": {
        "kind": "command",
        "path": ".opencode/commands/flow.md",
        "invocation": "/flow"
      },
      "docs": "https://opencode.ai/docs/commands/, https://opencode.ai/docs/skills/"
    },
    {
      "id": "codex",
      "host": "Codex",
      "cli": "codex",
      "skills": [
        ".agents/skills/{name}",
        "plugins/vibe/skills/{name}"
      ],
      "entry": {
        "kind": "skill",
        "skill": "flow",
        "invocation": "$flow",
        "picker": "/skills"
      },
      "package": {
        "manifest": "plugins/vibe/plugin.json",
        "marketplace": ".agents/plugins/marketplace.json"
      },
      "docs": "https://developers.openai.com/codex/skills, https://developers.openai.com/plugins/build/plugins"
    },
    {
      "id": "droid",
      "host": "Factory Droid",
      "cli": "droid",
      "skills": [
        "factory-plugin/skills/{name}",
        ".agents/skills/{name}"
      ],
      "entry": {
        "kind": "command",
        "path": "factory-plugin/commands/flow.md",
        "invocation": "/flow"
      },
      "package": {
        "manifest": "factory-plugin/.factory-plugin/plugin.json",
        "marketplace": ".factory-plugin/marketplace.json"
      },
      "docs": "https://docs.factory.ai/cli/configuration/plugins, https://docs.factory.ai/cli/configuration/custom-slash-commands, https://docs.factory.ai/cli/configuration/skills"
    }
  ]
}
