{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec JSON v1",
  "description": "Answers of vibe-spec commands when called with --json: the queries root, lessons-for, plan, feature, validate, trace and check-drift, plus promote, export and import (--openspec), setup, init and migrate. promote also writes (merge blocks, requirement deltas) and deletes (--done); export writes an openspec/ directory; import writes feature folders. Each answer is one JSON object with \"v\": 1. This is a new output; it is not the legacy `lessons-for.sh --format json` array, which stays byte-identical except that the port emits valid JSON: it escapes quotes, backslashes and control characters and replaces invalid UTF-8 with U+FFFD (pinned divergence).",
  "x-vibe-compat": "additive-within-major; readers-ignore-unknown-fields",
  "$defs": {
    "init": {
      "type": "object",
      "required": ["v", "root", "created", "skipped"],
      "properties": {
        "v": { "const": 1 },
        "root": { "type": "string", "minLength": 1, "description": "The seeded directory, project-relative with forward slashes." },
        "created": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "skipped": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "migrate": {
      "type": "object",
      "required": ["v", "from", "to", "moves", "rewrites", "created", "markers", "dry_run"],
      "properties": {
        "v": { "const": 1 },
        "from": { "type": "string", "minLength": 1, "description": "The spec root before the migration, project-relative with forward slashes." },
        "to": { "type": "string", "minLength": 1, "description": "The target root, project-relative with forward slashes." },
        "moves": { "type": "array", "items": { "$ref": "#/$defs/migrate-move" }, "description": "In execution order; the root move first." },
        "rewrites": { "type": "array", "items": { "$ref": "#/$defs/migrate-rewrite" }, "description": "Sorted by file, then line." },
        "created": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "New files, by their path after the moves." },
        "markers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Allow-markers inserted; always empty in a plan." },
        "dry_run": { "type": "boolean", "description": "True for --dry-run and --check: nothing was written." }
      }
    },
    "migrate-move": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 }
      }
    },
    "migrate-rewrite": {
      "type": "object",
      "required": ["file", "line", "old", "new"],
      "properties": {
        "file": { "type": "string", "minLength": 1, "description": "The file's path after the moves." },
        "line": { "type": "integer", "minimum": 1, "description": "First line, 1-based, in the file as it is before the migration." },
        "old": { "type": "string", "description": "The original text of one or more consecutive lines, joined by newline." },
        "new": { "type": "string" }
      }
    },
    "setup": {
      "type": "object",
      "required": ["v", "written", "skipped"],
      "properties": {
        "v": { "const": 1 },
        "written": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "skipped": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "openspec": {
      "type": "object",
      "required": ["v", "direction", "dir", "written"],
      "properties": {
        "v": { "const": 1 },
        "direction": { "enum": ["export", "import"] },
        "dir": { "type": "string", "minLength": 1 },
        "written": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "promote": {
      "type": "object",
      "required": ["v", "feature", "dry_run", "artifacts", "deleted"],
      "properties": {
        "v": { "const": 1 },
        "feature": { "type": "string", "minLength": 1 },
        "dry_run": { "type": "boolean" },
        "merge": {
          "type": "object",
          "required": ["source", "target", "appended", "skipped"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "target": { "type": "string", "minLength": 1 },
            "appended": { "type": "integer", "minimum": 0 },
            "skipped": { "type": "integer", "minimum": 0 }
          }
        },
        "delta": {
          "type": "object",
          "required": ["source", "target", "changes"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "target": { "type": "string", "minLength": 1 },
            "changes": { "type": "array", "items": { "$ref": "#/$defs/promote-change" } }
          }
        },
        "artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "checklist": { "type": "array", "items": { "$ref": "#/$defs/promote-item" } },
        "deleted": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "promote-change": {
      "type": "object",
      "required": ["op", "name", "applied"],
      "properties": {
        "op": { "enum": ["ADDED", "MODIFIED", "REMOVED"] },
        "name": { "type": "string", "minLength": 1 },
        "applied": { "type": "boolean" }
      }
    },
    "promote-item": {
      "type": "object",
      "required": ["what", "target"],
      "properties": {
        "what": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "check-drift": {
      "type": "object",
      "required": ["v", "root", "pre_merge", "errors", "warnings", "findings"],
      "properties": {
        "v": { "const": 1 },
        "root": { "type": "string", "minLength": 1 },
        "pre_merge": { "type": "boolean" },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "features": { "type": "array", "items": { "$ref": "#/$defs/drift-feature" } },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/drift-finding" } }
      }
    },
    "drift-feature": {
      "type": "object",
      "required": ["name", "status"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["NOT STARTED", "IN PROGRESS", "DONE", "NO ROW"] }
      }
    },
    "drift-finding": {
      "type": "object",
      "required": ["severity", "message"],
      "properties": {
        "severity": { "enum": ["warning", "error"] },
        "message": { "type": "string" },
        "file": { "type": "string", "minLength": 1 }
      }
    },
    "root": {
      "type": "object",
      "required": ["v", "root", "source"],
      "properties": {
        "v": { "const": 1 },
        "root": { "type": "string", "minLength": 1, "pattern": "^(/|[A-Za-z]:[\\\\/]|\\\\\\\\)", "description": "Absolute path of the spec root." },
        "source": { "enum": ["flag", "env", "config", "docs-spec", "dot-spec"], "description": "Discovery step that found the root (tech-spec.md, Root and discovery, steps 1-5)." },
        "depth": { "type": "integer", "minimum": 0, "description": "Parent directories walked before the hit (step 6); 0 for the cwd." },
        "layout": { "enum": ["flat", "layered"] }
      }
    },
    "lessons-for": {
      "type": "object",
      "required": ["v", "tags", "lessons"],
      "properties": {
        "v": { "const": 1 },
        "tags": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "lessons": { "type": "array", "items": { "$ref": "#/$defs/lesson" } }
      }
    },
    "lesson": {
      "type": "object",
      "required": ["title", "rule", "tags"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "pattern": { "type": "string" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "pinned": { "type": "boolean" }
      }
    },
    "plan": {
      "type": "object",
      "required": ["v", "feature", "rows"],
      "properties": {
        "v": { "const": 1 },
        "feature": { "$ref": "#/$defs/feature-name" },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/plan-row" } },
        "source": { "$ref": "#/$defs/doc" }
      }
    },
    "plan-row": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "gate": { "type": "string" }
      }
    },
    "feature": {
      "type": "object",
      "required": ["v", "feature", "layer", "docs"],
      "properties": {
        "v": { "const": 1 },
        "feature": { "$ref": "#/$defs/feature-name" },
        "layer": { "enum": ["superpowers", "fallback"] },
        "docs": { "type": "array", "items": { "$ref": "#/$defs/doc" } },
        "status": { "type": "string" },
        "summary": { "type": "string" }
      }
    },
    "feature-name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "validate": {
      "type": "object",
      "required": ["v", "root", "layout", "strict", "examined", "errors", "warnings", "checks", "findings"],
      "properties": {
        "v": { "const": 1 },
        "root": { "type": "string", "minLength": 1, "description": "The spec root as validate prints it: project-relative, or absolute outside the project." },
        "layout": { "enum": ["flat", "layered"] },
        "strict": { "type": "boolean" },
        "examined": { "type": "integer", "minimum": 0, "description": "Distinct files the run examined." },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/check-level" } },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
      }
    },
    "trace": {
      "type": "object",
      "required": ["v", "units", "cited", "history", "uncited", "orphans"],
      "properties": {
        "v": { "const": 1 },
        "units": { "type": "integer", "minimum": 1 },
        "cited": { "type": "integer", "minimum": 0 },
        "history": { "enum": ["all", "since", "none"] },
        "since": { "type": "string", "minLength": 1 },
        "uncited": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "orphans": { "type": "array", "items": { "$ref": "#/$defs/orphan" } }
      }
    },
    "orphan": {
      "type": "object",
      "required": ["unit", "source"],
      "properties": {
        "unit": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "check-level": {
      "type": "object",
      "required": ["id", "level"],
      "properties": {
        "id": { "$ref": "#/$defs/check-id" },
        "level": { "enum": ["default", "warn", "error", "off"] }
      }
    },
    "finding": {
      "type": "object",
      "required": ["check", "severity", "message"],
      "properties": {
        "check": { "$ref": "#/$defs/check-id" },
        "severity": { "enum": ["warning", "error"] },
        "file": { "type": "string", "minLength": 1, "description": "Project-relative path with forward slashes; absolute outside the project." },
        "message": { "type": "string" }
      }
    },
    "check-id": { "type": "string", "pattern": "^(SF[0-9]+|I[0-9]+)$" },
    "doc": {
      "type": "object",
      "required": ["kind", "path"],
      "properties": {
        "kind": { "enum": ["design", "plan", "product", "tech", "research"] },
        "path": { "type": "string", "minLength": 1, "description": "Repo-relative path with forward slashes." }
      }
    }
  }
}
