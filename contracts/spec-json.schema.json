{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec JSON v1",
  "description": "Answers of the read-only vibe-spec queries when called with --json: root, lessons-for, plan, feature, validate, trace. Each answer is one JSON object with \"v\": 1. This is a new output; it is not the legacy `lessons-for.sh --format json` array, which stays byte-identical except that the port emits valid JSON: it escapes quotes, backslashes and control characters and replaces invalid UTF-8 with U+FFFD (pinned divergence).",
  "x-vibe-compat": "additive-within-major; readers-ignore-unknown-fields",
  "$defs": {
    "root": {
      "type": "object",
      "required": ["v", "root", "source"],
      "properties": {
        "v": { "const": 1 },
        "root": { "type": "string", "minLength": 1, "pattern": "^(/|[A-Za-z]:[\\\\/]|\\\\\\\\)", "description": "Absolute path of the spec root." },
        "source": { "enum": ["flag", "env", "config", "docs-spec", "dot-spec"], "description": "Discovery step that found the root (tech-spec.md, Root and discovery, steps 1-5)." },
        "depth": { "type": "integer", "minimum": 0, "description": "Parent directories walked before the hit (step 6); 0 for the cwd." },
        "layout": { "enum": ["flat", "layered"] }
      }
    },
    "lessons-for": {
      "type": "object",
      "required": ["v", "tags", "lessons"],
      "properties": {
        "v": { "const": 1 },
        "tags": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "lessons": { "type": "array", "items": { "$ref": "#/$defs/lesson" } }
      }
    },
    "lesson": {
      "type": "object",
      "required": ["title", "rule", "tags"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "pattern": { "type": "string" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "pinned": { "type": "boolean" }
      }
    },
    "plan": {
      "type": "object",
      "required": ["v", "feature", "rows"],
      "properties": {
        "v": { "const": 1 },
        "feature": { "$ref": "#/$defs/feature-name" },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/plan-row" } },
        "source": { "$ref": "#/$defs/doc" }
      }
    },
    "plan-row": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "gate": { "type": "string" }
      }
    },
    "feature": {
      "type": "object",
      "required": ["v", "feature", "layer", "docs"],
      "properties": {
        "v": { "const": 1 },
        "feature": { "$ref": "#/$defs/feature-name" },
        "layer": { "enum": ["superpowers", "fallback"] },
        "docs": { "type": "array", "items": { "$ref": "#/$defs/doc" } },
        "status": { "type": "string" },
        "summary": { "type": "string" }
      }
    },
    "feature-name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "validate": {
      "type": "object",
      "required": ["v", "root", "layout", "strict", "examined", "errors", "warnings", "checks", "findings"],
      "properties": {
        "v": { "const": 1 },
        "root": { "type": "string", "minLength": 1, "description": "The spec root as validate prints it: project-relative, or absolute outside the project." },
        "layout": { "enum": ["flat", "layered"] },
        "strict": { "type": "boolean" },
        "examined": { "type": "integer", "minimum": 0, "description": "Distinct files the run examined." },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/check-level" } },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
      }
    },
    "trace": {
      "type": "object",
      "required": ["v", "units", "cited", "history", "uncited", "orphans"],
      "properties": {
        "v": { "const": 1 },
        "units": { "type": "integer", "minimum": 1 },
        "cited": { "type": "integer", "minimum": 0 },
        "history": { "enum": ["all", "since", "none"] },
        "since": { "type": "string", "minLength": 1 },
        "uncited": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "orphans": { "type": "array", "items": { "$ref": "#/$defs/orphan" } }
      }
    },
    "orphan": {
      "type": "object",
      "required": ["unit", "source"],
      "properties": {
        "unit": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "check-level": {
      "type": "object",
      "required": ["id", "level"],
      "properties": {
        "id": { "$ref": "#/$defs/check-id" },
        "level": { "enum": ["default", "warn", "error", "off"] }
      }
    },
    "finding": {
      "type": "object",
      "required": ["check", "severity", "message"],
      "properties": {
        "check": { "$ref": "#/$defs/check-id" },
        "severity": { "enum": ["warning", "error"] },
        "file": { "type": "string", "minLength": 1, "description": "Project-relative path with forward slashes; absolute outside the project." },
        "message": { "type": "string" }
      }
    },
    "check-id": { "type": "string", "pattern": "^(SF[0-9]+|I[0-9]+)$" },
    "doc": {
      "type": "object",
      "required": ["kind", "path"],
      "properties": {
        "kind": { "enum": ["design", "plan", "product", "tech", "research"] },
        "path": { "type": "string", "minLength": 1, "description": "Repo-relative path with forward slashes." }
      }
    }
  }
}
