{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow runtime v2 and record v1 contracts",
  "description": "Structural wire contracts. Semantic progression, scope, evidence sufficiency and trusted origin remain Rust checks. Records authored by agents never authenticate approval or check execution. Runtime identity fields mirror Rust safe_id; map-key and phase/state membership checks require the selected runtime machine. Evidence IDs and CheckResult IDs are observation labels, not runtime filenames; their nonempty-string structure does not establish runtime membership.",
  "x-vibe-compat": "additive-within-major; readers-ignore-unknown-fields",
  "$defs": {
    "cursor": {
      "type": "object",
      "required": [
        "v",
        "flow",
        "phase",
        "feature",
        "updated",
        "run_id",
        "revision",
        "plan_digest",
        "scope_digest",
        "task_state",
        "evidence_refs"
      ],
      "properties": {
        "v": {
          "const": 2
        },
        "flow": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]{1,128}$"
        },
        "updated": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "$ref": "#/$defs/runtime-id"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "plan_digest": {
          "type": "string",
          "minLength": 1
        },
        "scope_digest": {
          "type": "string",
          "minLength": 1
        },
        "task_state": {
          "type": "object"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtime-id"
          }
        }
      }
    },
    "request": {
      "type": "object",
      "required": [
        "v",
        "run_id",
        "expected_revision",
        "target",
        "feature",
        "approval_ref",
        "candidate_digest",
        "action_ref"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "run_id": {
          "$ref": "#/$defs/runtime-id"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]{1,128}$"
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "action_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "v",
        "status",
        "revision",
        "cursor",
        "reasons"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "status": {
          "enum": [
            "applied",
            "denied"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "argv",
        "cwd",
        "exit_code",
        "output_digest",
        "output_path",
        "started_at",
        "finished_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer"
        },
        "output_digest": {
          "type": "string",
          "minLength": 1
        },
        "output_path": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "minLength": 1
        },
        "finished_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "v",
        "evidence_id",
        "run_id",
        "task_ids",
        "candidate_digest",
        "source",
        "checks",
        "review",
        "verdict"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "$ref": "#/$defs/runtime-id"
        },
        "task_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtime-id"
          }
        },
        "candidate_digest": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "review": {
          "type": "object"
        },
        "verdict": {
          "enum": [
            "passed",
            "gaps_found",
            "human_needed"
          ]
        }
      }
    },
    "task-brief": {
      "type": "object",
      "required": [
        "task_id",
        "run_id",
        "plan_digest",
        "requirements",
        "read_paths",
        "write_scope",
        "dependencies",
        "checks",
        "role"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/runtime-id"
        },
        "run_id": {
          "$ref": "#/$defs/runtime-id"
        },
        "plan_digest": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "read_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "write_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtime-id"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "task-result": {
      "type": "object",
      "required": [
        "task_id",
        "status",
        "changed_paths",
        "check_results",
        "findings",
        "artifacts",
        "candidate_digest"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/runtime-id"
        },
        "status": {
          "enum": [
            "done",
            "needs_context",
            "blocked",
            "failed"
          ]
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "check_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "findings": {
          "type": "array"
        },
        "artifacts": {
          "type": "array"
        },
        "candidate_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime-id": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]{1,128}$",
      "description": "Rust runtime safe_id: 1\u2013128 ASCII letters/digits or -_.; excludes the identifiers \".\" and \"..\". This is an identifier, never a path."
    }
  }
}
