{
  "root": "docs/spec",
  "migrate": {
    "include": [
      "spec/**/*.md",
      "flow/**/*.md",
      "flow/reference/templates/**",
      "docs/roadmap/**",
      ".github/**",
      "README.md",
      "AGENTS.md"
    ],
    "exclude": [
      "oracles/**",
      "spec/scripts/**",
      "docs/superpowers/**",
